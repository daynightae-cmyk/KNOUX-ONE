{
  "name": "knoux-one",
  "private": true,
  "version": "1.0.0",
  "description": "KNOUX ONE — Windows Intelligence & Developer Suite",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "services:generate": "bun scripts/generate-service-reality.ts",
    "services:check": "bun scripts/generate-service-reality.ts --check",
    "verify:service-exclusivity": "bun scripts/verify-service-exclusivity.ts",
    "release:verify-version": "bun scripts/verify-release-version.ts",
    "release:verify-signatures": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-signatures.ps1",
    "release:create-update-manifest": "bun scripts/create-update-manifest.ts",
    "verify:windows-deps": "bun scripts/verify-windows-dependency-graph.ts",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "source-map-js": "1.2.2"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^0.546.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.20.1",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  }
}
