{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KNOUX ONE",
  "version": "1.0.0",
  "identifier": "com.knoux.one",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KNOUX ONE — Windows Intelligence & Developer Suite",
        "width": 1280,
        "height": 830,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob:",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' http://localhost:3000 ws://localhost:3000",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "connect-src": "'self' http://localhost:3000 ws://localhost:* https://api.github.com",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0NjQ4QzA2NDZBQzU0QzgKUldUSVZLeEdCb3hrTkUzUWhIYWNMSlBYcXljck4xdWxKVGFrZzRpb0thNnNVKzk1QUN0amN2VUIK",
      "endpoints": [
        "https://github.com/daynightae-cmyk/KNOUX-ONE/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
